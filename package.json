{
  "name": "enterprise-commerce-os",
  "version": "0.1.0",
  "private": true,
  "description": "Çok kanallı e-ticaret yönetim platformu (pazaryerleri + kendi mağazalar)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @eco/api",
    "dev:web": "npm run dev -w @eco/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run prisma:migrate -w @eco/api",
    "db:seed": "npm run prisma:seed -w @eco/api",
    "db:studio": "npm run prisma:studio -w @eco/api"
  },
  "engines": {
    "node": ">=20"
  }
}
